# Server Configuration
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_password
DB_NAME=ecommerce_db

# Optional root credentials used by db:setup / db:reset script
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# Payments (optional). Leave empty to use the simulated demo checkout.
# Stripe: cards, Apple Pay, Google Pay. Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# PayPal Checkout. Sandbox app keys: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default, test money) or live (real money)
PAYPAL_MODE=sandbox
